{
  "schema": "unilink.session-state/1",
  "initial": "DISCOVERING",
  "terminal": ["CLOSED", "FAILED"],
  "states": ["DISCOVERING","PAIRING","CONNECTING","AUTHENTICATING","NEGOTIATING","CONNECTED","DEGRADED","RECONNECTING","CLOSING","CLOSED","FAILED"],
  "events": ["DISCOVERY_FOUND","PAIR_ABORT","PAIR_INVALID","PAIR_ACCEPTED","LINK_ESTABLISHED","LINK_FAILED","HANDSHAKE_OK","NEGOTIATION_OK","NEGOTIATION_FAILED","HEALTH_DEGRADED","HEALTH_RECOVERED","HEALTH_TIMEOUT","LINK_LOST","STOP_REQUESTED","RESUME_READY","ATTEMPTS_EXHAUSTED","CLOSE_CONFIRMED","CLOSE_TIMEOUT","FATAL_ERROR","RESET","NEW_SESSION"],
  "transitions": {
    "DISCOVERING":   {"DISCOVERY_FOUND":"PAIRING","FATAL_ERROR":"FAILED"},
    "PAIRING":       {"PAIR_ABORT":"DISCOVERING","PAIR_INVALID":"FAILED","PAIR_ACCEPTED":"CONNECTING","FATAL_ERROR":"FAILED"},
    "CONNECTING":    {"LINK_ESTABLISHED":"AUTHENTICATING","LINK_FAILED":"RECONNECTING","ATTEMPTS_EXHAUSTED":"FAILED","STOP_REQUESTED":"CLOSING","FATAL_ERROR":"FAILED"},
    "AUTHENTICATING":{"HANDSHAKE_OK":"NEGOTIATING","LINK_FAILED":"RECONNECTING","ATTEMPTS_EXHAUSTED":"FAILED","FATAL_ERROR":"FAILED"},
    "NEGOTIATING":   {"NEGOTIATION_OK":"CONNECTED","NEGOTIATION_FAILED":"RECONNECTING","ATTEMPTS_EXHAUSTED":"FAILED","FATAL_ERROR":"FAILED"},
    "CONNECTED":     {"HEALTH_DEGRADED":"DEGRADED","LINK_LOST":"RECONNECTING","STOP_REQUESTED":"CLOSING","FATAL_ERROR":"FAILED"},
    "DEGRADED":      {"HEALTH_RECOVERED":"CONNECTED","HEALTH_TIMEOUT":"RECONNECTING","LINK_LOST":"RECONNECTING","STOP_REQUESTED":"CLOSING","FATAL_ERROR":"FAILED"},
    "RECONNECTING":  {"RESUME_READY":"CONNECTING","ATTEMPTS_EXHAUSTED":"FAILED","STOP_REQUESTED":"CLOSING","FATAL_ERROR":"FAILED"},
    "CLOSING":       {"CLOSE_CONFIRMED":"CLOSED","CLOSE_TIMEOUT":"CLOSED","FATAL_ERROR":"FAILED"},
    "CLOSED":        {"NEW_SESSION":"DISCOVERING"},
    "FAILED":        {"RESET":"CLOSED"}
  },
  "recv_owner_states": ["AUTHENTICATING","NEGOTIATING","CONNECTED","DEGRADED"],
  "notes": "Exactly one component (the state-machine owner) may consume control frames, and only in recv_owner_states. Rebinding a session_id to a second live machine is forbidden (dual-consumer prevention)."
}
